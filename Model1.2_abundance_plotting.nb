Cell[CellGroupData[{
Cell["Model 1: Abundance Plots", "Title",
 CellChangeTimes->{{3.91760937135043*^9, 3.9176093750031347`*^9}, {
  3.96161918589888*^9, 
  3.9616191881409073`*^9}},ExpressionUUID->"7de112f4-909a-47f9-8806-\
13d6a74e8836"],

Cell[TextData[{
 "This file contains the processing code for Model 1: Comparing Temporally \
Blind and Temporally Explicit Metrics. Before running this file, you must \
have extinction time and population size outputs from running Model 1 for \
both TPCs using Model1.nb; edit import and export locations (via \
\[OpenCurlyQuote]saveto\[CloseCurlyQuote]) for your own device. Use to \
generate Fig 4. ",
 StyleBox["(*",
  FontWeight->"Bold"],
 StyleBox["7 Nov 2025 update: ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "Corrected typo in beta param of TPC2 and updated color scheme + line \
thickness for Fig 4 (plus adjusted max/min bounds to match between species \
for easier comparison); fixed glitch in CD index outputs -- CDMatrixT was \
using ",
 StyleBox["p ",
  FontSlant->"Italic"],
 "instead of ",
 StyleBox["pT ",
  FontSlant->"Italic"],
 "(though graph in manuscript was already corrected from a separate file) ",
 StyleBox["*)",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.917609392239852*^9, 3.9176094359386177`*^9}, {
  3.917609506895487*^9, 3.917609514078164*^9}, {3.917609824955009*^9, 
  3.9176098273971653`*^9}, {3.961616770546258*^9, 3.961616778042137*^9}, {
  3.971778633727151*^9, 
  3.97177883526572*^9}},ExpressionUUID->"810a0593-9416-4da3-ad63-\
eb5a7290580d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"saveto", "=", "\"\</SAVETO/\>\""}], ";"}]], "Input",
