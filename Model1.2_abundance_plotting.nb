      RowBox[{"ninit", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "k"}], "]"}], "]"}], "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Mean", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"r", "[", 
            RowBox[{"W", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "k", ",", "j"}], "]"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "tmax"}], "}"}]}], "]"}], "]"}], 
        ")"}], "/", "\[Alpha]"}]}], ",", 
     RowBox[{"{", 
