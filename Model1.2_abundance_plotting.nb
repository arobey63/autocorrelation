Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"TEMPORATE", " ", "-", " ", "TPC1"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"gain", "[", "T_", "]"}], ":=", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"T", "-", "TI"}], ")"}], "^", "2"}], ")"}]}], "/", 
       "\[Beta]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"loss", "[", "T_", "]"}], ":=", 
     RowBox[{
      RowBox[{"ma", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"mb", " ", "T"}], "]"}]}], "+", "mc"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"r", "[", "T_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"gain", "[", "T", "]"}], "-", 
        RowBox[{"loss", "[", "T", "]"}]}], ")"}], "/", ".755"}]}], ";"}], " ",
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Parameters", " ", "of", " ", "the", " ", "TPC", " ", "model"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TI", "=", "29"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Beta]", "=", "180"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ma", "=", "0.000005"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mb", "=", "0.4"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mc", "=", "0.05"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Alpha]", "=", ".001"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "array", " ", "of", " ", "temperatures", " ", "for", " ", "each", " ", 
     "parameter", " ", "set"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"W", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Length", "[", "\[Mu]Tvals", "]"}], ",", 
         RowBox[{"Length", "[", "\[Sigma]Tvals", "]"}], ",", "tmax"}], 
        "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"W", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], "=", 
      RowBox[{"InverseCDF", "[", 
       RowBox[{
        RowBox[{"NormalDistribution", "[", 
         RowBox[{
          RowBox[{"\[Mu]Tvals", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"\[Sigma]Tvals", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
        RowBox[{"k", "*", 
         RowBox[{"(", 
          RowBox[{"1", "/", "tmax"}], ")"}]}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "\[Mu]Tvals", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{"Length", "[", "\[Sigma]Tvals", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", 
       RowBox[{"tmax", "-", "1"}]}], "}"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"W", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j", ",", "tmax"}], "]"}], "]"}], "=", 
       RowBox[{"InverseCDF", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{
           RowBox[{"\[Mu]Tvals", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"\[Sigma]Tvals", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"tmax", "-", ".5"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"1", "/", "tmax"}], ")"}]}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "\[Mu]Tvals", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", 
        RowBox[{"Length", "[", "\[Sigma]Tvals", "]"}]}], "}"}]}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "set", " ", "initial", " ", "pop", " ", "size", " ", "to", " ", "mean", 
     " ", "pop", " ", "size", " ", "for", " ", "each", " ", "parameter", " ", 
     "set"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ninit", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Length", "[", "\[Mu]Tvals", "]"}], ",", 
         RowBox[{"Length", "[", "\[Sigma]Tvals", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ninit", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "k"}], "]"}], "]"}], "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Mean", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"r", "[", 
            RowBox[{"W", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "k", ",", "j"}], "]"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "tmax"}], "}"}]}], "]"}], "]"}], 
        ")"}], "/", "\[Alpha]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", 
       RowBox[{"Length", "[", "\[Sigma]Tvals", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "\[Mu]Tvals", "]"}]}], "}"}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"N", "[", "ninit", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"l23", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"ninit", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
