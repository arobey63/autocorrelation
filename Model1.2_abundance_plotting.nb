Cell["\<\
Given the imported extinction times and population sizes, calculate the \
extinction metrics (abundance, stability, and probability of extinction) and \
create plotting arrays.\
\>", "Text",
 CellChangeTimes->{{3.917611060119491*^9, 
  3.917611096384572*^9}},ExpressionUUID->"85fb8b73-8d36-4e52-a522-\
07012d485744"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "initialize", " ", "functions", " ", "for", " ", "calculating", " ", 
     "the", " ", "proportion", " ", "variance", " ", "index", " ", 
     RowBox[{"(", "PV", ")"}], " ", "and", " ", "consecutive", " ", 
     "disparity", " ", "index", " ", 
     RowBox[{"(", "CD", ")"}]}], ";", " ", 
    RowBox[{
    "only", " ", "the", " ", "latter", " ", "is", " ", "computed", " ", 
     "here"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"CDindex", "[", "data_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", "diffs"}], "}"}], ",", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "data", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"diffs", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{"Log", "[", 
          RowBox[{
           RowBox[{"data", "[", 
            RowBox[{"[", 
             RowBox[{"2", ";;"}], "]"}], "]"}], "/", 
           RowBox[{"data", "[", 
            RowBox[{"[", 
             RowBox[{"1", ";;", 
              RowBox[{"-", "2"}]}], "]"}], "]"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Mean", "[", "diffs", "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"PVindex", "[", "data_List", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", "pairs", ",", "zsum"}], "}"}], ",", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "data", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"pairs", "=", 
         RowBox[{"Subsets", "[", 
          RowBox[{"data", ",", 
           RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"zsum", "=", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Min", "[", "#", "]"}], "/", 
                RowBox[{"Max", "[", "#", "]"}]}], ")"}]}], ")"}], "&"}], "/@",
            "pairs"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "*", "zsum"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"n", "*", 
           RowBox[{"(", 
            RowBox[{"n", "-", "1"}], ")"}]}], ")"}]}]}]}], "]"}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "TEMPERATE", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"meansMatrix", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Length", "[", "\[Gamma]vals", "]"}], ",", 
         RowBox[{"Length", "[", "\[Mu]Tvals", "]"}], ",", "maxsims"}], 
        "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"stdevsMatrix", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Length", "[", "\[Gamma]vals", "]"}], ",", 
         RowBox[{"Length", "[", "\[Mu]Tvals", "]"}], ",", "maxsims"}], 
        "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"stabilityMatrix", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Length", "[", "\[Gamma]vals", "]"}], ",", 
         RowBox[{"Length", "[", "\[Mu]Tvals", "]"}], ",", "maxsims"}], 
        "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"extMatrix", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Length", "[", "\[Gamma]vals", "]"}], ",", 
         RowBox[{"Length", "[", "\[Mu]Tvals", "]"}], ",", "maxsims"}], 
        "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cdMatrix", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Length", "[", "\[Gamma]vals", "]"}], ",", 
         RowBox[{"Length", "[", "\[Mu]Tvals", "]"}], ",", "maxsims"}], 
        "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "averaging", " ", "over", " ", "all", " ", "timesteps", " ", "before", 
     " ", "extinction", " ", "within", " ", "a", " ", "simulation"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"extTime", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "1", ",", "l"}], "]"}], "]"}], "<", 
         "tmax"}], ",", 
        RowBox[{
         RowBox[{"extMatrix", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "l"}], "]"}], "]"}], "=", "1"}], ",", 
        RowBox[{
         RowBox[{"extMatrix", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "l"}], "]"}], "]"}], "=", "0"}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"meansMatrix", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j", ",", "l"}], "]"}], "]"}], "=", 
       RowBox[{"Mean", "[", 
        RowBox[{"p", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j", ",", "1", ",", "l", ",", 
           RowBox[{"2", ";;", 
            RowBox[{"extTime", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j", ",", "1", ",", "l"}], "]"}], "]"}]}]}], 
          "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"stdevsMatrix", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j", ",", "l"}], "]"}], "]"}], "=", 
       RowBox[{"StandardDeviation", "[", 
        RowBox[{"p", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j", ",", "1", ",", "l", ",", 
           RowBox[{"2", ";;", 
            RowBox[{"extTime", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j", ",", "1", ",", "l"}], "]"}], "]"}]}]}], 
          "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"stabilityMatrix", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j", ",", "l"}], "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{"meansMatrix", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j", ",", "l"}], "]"}], "]"}], "/", 
        RowBox[{"stdevsMatrix", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j", ",", "l"}], "]"}], "]"}]}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"l", ",", "1", ",", "maxsims"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{"Length", "[", "\[Mu]Tvals", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "\[Gamma]vals", "]"}]}], "}"}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"cdMatrix", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j", ",", "l"}], "]"}], "]"}], "=", 
      RowBox[{"CDindex", "[", 
       RowBox[{
        RowBox[{"p", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j", ",", "1", ",", "l", ",", 
           RowBox[{"2", ";;", 
            RowBox[{"extTime", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j", ",", "1", ",", "l"}], "]"}], "]"}]}]}], 
          "]"}], "]"}], "+", ".1"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "1", ",", "maxsims"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{"Length", "[", "\[Mu]Tvals", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "\[Gamma]vals", "]"}]}], "}"}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"cdMatrix", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
      RowBox[{"DeleteAnomalies", "[", 
       RowBox[{"cdMatrix", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{"Length", "[", "\[Mu]Tvals", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "\[Gamma]vals", "]"}]}], "}"}]}], "]"}], " ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "averaging", " ", "across", " ", "simulations", " ", "with", " ", "the", 
     " ", "same", " ", "params"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"meansVals", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Length", "[", "\[Gamma]vals", "]"}], ",", 
         RowBox[{"Length", "[", "\[Mu]Tvals", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"meansQ1", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Length", "[", "\[Gamma]vals", "]"}], ",", 
         RowBox[{"Length", "[", "\[Mu]Tvals", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"meansQ3", "=", 
