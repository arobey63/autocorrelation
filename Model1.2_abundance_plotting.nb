   RowBox[{
    RowBox[{"ninit", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Length", "[", "\[Mu]Tvals", "]"}], ",", 
