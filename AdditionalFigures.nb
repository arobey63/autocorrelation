Cell["\<\
This recreates the Gaussian-quadratic TPC of the organisms most similar to \
those used in initial models.\
\>", "Text",
 CellChangeTimes->{{3.9295526025795937`*^9, 
  3.929552627611977*^9}},ExpressionUUID->"c3b670a1-22c4-4ae0-b172-\
6eb9519b3ceb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rD", "[", 
     RowBox[{"T_", ",", "Topt_", ",", "\[Sigma]p_", ",", "CTmax_"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"T", "\[LessEqual]", "Topt"}], ",", 
      RowBox[{"Exp", "[", 
       RowBox[{"-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"T", "-", "Topt"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "\[Sigma]p"}], ")"}]}], ")"}], "^", "2"}]}], "]"}], 
      ",", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"T", "-", "Topt"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"Topt", "-", "CTmax"}], ")"}]}], ")"}], "^", "2"}]}]}], 
     "]"}]}], ";"}], " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"temporate", " ", "TPCs"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CTmax", "=", "31.4"}], ";", 
  RowBox[{"Topt", "=", "25.3"}], ";", 
  RowBox[{"\[Sigma]p", "=", "4.8"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CTmax2", "=", "28.82"}], ";", 
  RowBox[{"Topt2", "=", "23.88"}], ";", 
  RowBox[{"\[Sigma]p2", "=", "4.395"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CTmax3", "=", "30.225"}], ";", 
  RowBox[{"Topt3", "=", "25.8"}], ";", 
  RowBox[{"\[Sigma]p3", "=", "4.29375"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CTmax4", "=", "29"}], ";", 
  RowBox[{"Topt4", "=", "24"}], ";", 
  RowBox[{"\[Sigma]p4", "=", "4.185"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CTmax5", "=", "32.1"}], ";", 
   RowBox[{"Topt5", "=", "25.78"}], ";", 
   RowBox[{"\[Sigma]p5", "=", "4.395"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"tropical", " ", "TPCs"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TCTmax", "=", "33.0677"}], ";", 
  RowBox[{"TTopt", "=", "28.8"}], ";", 
  RowBox[{"T\[Sigma]p", "=", "2.375"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TCTmax2", "=", "33.46"}], ";", 
  RowBox[{"TTopt2", "=", "30.1"}], ";", 
  RowBox[{"T\[Sigma]p2", "=", "3.315"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TCTmax3", "=", "30.55"}], ";", 
  RowBox[{"TTopt3", "=", "27.2"}], ";", 
  RowBox[{"T\[Sigma]p3", "=", "1.9875"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TCTmax4", "=", "31.78"}], ";", 
  RowBox[{"TTopt4", "=", "27.98"}], ";", 
  RowBox[{"T\[Sigma]p4", "=", "3.675"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TCTmax5", "=", "31.96"}], ";", 
   RowBox[{"TTopt5", "=", "27.84"}], ";", 
   RowBox[{"T\[Sigma]p5", "=", "3.675"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DeutschTPCs", "=", 
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"rD", "[", 
         RowBox[{"T", ",", "25", ",", "4.8", ",", "30.4"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"T", ",", "0", ",", "37"}], "}"}], ",", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Darker", "[", "Cyan", "]"}], ",", 
           RowBox[{"Thickness", "[", "0.02", "]"}]}], "}"}]}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"Placed", "[", 
          RowBox[{
           RowBox[{"{", "\"\<temperate TPC\>\"", "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0.22", ",", "0.8"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"PlotRange", "->", 
