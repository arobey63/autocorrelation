a447cc351eba"],

Cell["\<\
This code tests the impact of the timestep size, \[Delta]t, on population \
dynamics. Models are stochastic, so will not output exactly the same graphs \
on every run.\
\>", "Text",
 CellChangeTimes->{{3.929553167969696*^9, 3.929553183880145*^9}, {
  3.9295547703227243`*^9, 
  3.92955478453165*^9}},ExpressionUUID->"ae2e96d4-f7b9-4d7f-8238-\
9ab95d258a67"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"background", " ", "functions"}], " ", "-", " ", 
    RowBox[{
    "same", " ", "as", " ", "other", " ", "versions", " ", "with", " ", 
     "\[Delta]t", " ", "added", " ", "in", " ", "and", " ", "an", " ", "edit",
      " ", "to", " ", "the", " ", "indexing", " ", "in", " ", "Z", " ", "to", 
     " ", "allow", " ", "for", " ", "multiple", " ", "runs"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"r", "[", 
      RowBox[{"T_", ",", "Topt_", ",", "\[Sigma]p_", ",", "CTmax_"}], "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"T", "\[LessEqual]", "Topt"}], ",", 
       RowBox[{"Exp", "[", 
        RowBox[{"-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"T", "-", "Topt"}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", "\[Sigma]p"}], ")"}]}], ")"}], "^", "2"}]}], "]"}], 
       ",", 
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"T", "-", "Topt"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"Topt", "-", "CTmax"}], ")"}]}], ")"}], "^", "2"}]}]}], 
      "]"}]}], ";"}], " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"nt", "[", 
      RowBox[{"t_", ",", "ntlast_", ",", "\[Delta]t_", ",", "i_"}], "]"}], ":=", 
     FractionBox[
      RowBox[{
       RowBox[{"r", "[", 
        RowBox[{
         RowBox[{"Z", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "t"}], "]"}], "]"}], ",", "Topt", ",", 
         "\[Sigma]p", ",", "CTmax"}], "]"}], "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"r", "[", 
          RowBox[{
           RowBox[{"Z", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "t"}], "]"}], "]"}], ",", "Topt", ",", 
           "\[Sigma]p", ",", "CTmax"}], "]"}], "*", "\[Delta]t"}], " ", 
        "]"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{"r", "[", 
           RowBox[{
            RowBox[{"Z", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "t"}], "]"}], "]"}], ",", "Topt", ",", 
            "\[Sigma]p", ",", "CTmax"}], "]"}], "ntlast"], "-", "\[Alpha]"}], 
        ")"}], "+", 
       RowBox[{"\[Alpha]", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"r", "[", 
           RowBox[{
            RowBox[{"Z", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "t"}], "]"}], "]"}], ",", "Topt", ",", 
            "\[Sigma]p", ",", "CTmax"}], "]"}], "*", "\[Delta]t"}], 
         "]"}]}]}]]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "unchanging", " ", "parameters", " ", "for", " ", "TPC", " ", "and", " ", 
     "temps"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Topt", "=", "25"}], ";", 
    RowBox[{"\[Sigma]p", "=", "5"}], ";", 
    RowBox[{"CTmax", "=", "30"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"TPC", " ", "params"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Alpha]", "=", ".001"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Mu]T", "=", "25"}], ";", " ", 
    RowBox[{"\[Sigma]T", "=", "3"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"temp", " ", "params"}], "-", 
     RowBox[{
     "values", " ", "for", " ", "some", " ", "extinction", " ", "risk"}]}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tmax", "=", "100"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"number", " ", "of", " ", "time", " ", "steps"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nmax", "=", "500"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"number", " ", "of", " ", "replicates"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "initializing", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Delta]ts", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0.01", ",", "0.09", ",", "0.01"}], "]"}], ",", 
       RowBox[{"Range", "[", 
        RowBox[{"0.1", ",", "0.9", ",", "0.1"}], "]"}], ",", 
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", "10"}], "]"}], ",", 
       RowBox[{"Range", "[", 
        RowBox[{"20", ",", "100", ",", "10"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"means", "=", 
     RowBox[{"vars", "=", 
      RowBox[{"stdevs", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"nmax", ",", 
           RowBox[{"Length", "[", "\[Delta]ts", "]"}]}], "}"}]}], "]"}]}]}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cvs", "=", 
     RowBox[{"equidists", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"Length", "[", "\[Delta]ts", "]"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"extTime", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"tmax", ",", 
       RowBox[{"{", 
        RowBox[{"nmax", ",", 
         RowBox[{"Length", "[", "\[Delta]ts", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"set", " ", "up", " ", "thermal", " ", "regimes"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Z", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{"nmax", ",", "tmax"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Z", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "k"}], "]"}], "]"}], "=", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{"NormalDistribution", "[", 
         RowBox[{"\[Mu]T", ",", "\[Sigma]T"}], "]"}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "tmax"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "nmax"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Mu]r", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "nmax"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Mu]r", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "=", 
       RowBox[{"Mean", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"r", "[", 
           RowBox[{
