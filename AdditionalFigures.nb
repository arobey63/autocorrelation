Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "background", " ", "functions", " ", "for", " ", "spectral", " ", 
    "synthesis", " ", "and", " ", "mimicry"}], "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"cmplx", "[", 
      RowBox[{"mod_", ",", "arg_"}], "]"}], ":=", 
     RowBox[{"ExpToTrig", "[", 
      RowBox[{"mod", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", "arg"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SpecSynFourier", "[", 
      RowBox[{"\[Gamma]_", ",", "Nobs_", ",", 
       RowBox[{"\[Mu]_", ":", "0"}], ",", 
       RowBox[{"\[Sigma]_", ":", "1"}], ",", 
       RowBox[{"seed_", ":", "0"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"phase", ",", "f", ",", "vec"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"seed", "\[Equal]", "0"}], ",", 
          RowBox[{"SeedRandom", "[", "]"}], ",", 
          RowBox[{"SeedRandom", "[", "seed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"phase", "=", 
         RowBox[{"RandomReal", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"2", "Pi"}]}], "}"}], ",", "Nobs"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"f", "=", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"1", "/", "Nobs"}], ",", "1", ",", 
           RowBox[{"1", "/", "Nobs"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"vec", "=", 
         RowBox[{"InverseFourier", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", "+", 
               RowBox[{"0", "I"}]}], "}"}], ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"cmplx", "[", 
                RowBox[{
                 RowBox[{"1", "/", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"f", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "^", 
                    RowBox[{"(", 
                    RowBox[{"\[Gamma]", "/", "2"}], ")"}]}], ")"}]}], ",", 
                 RowBox[{"phase", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"(", 
                  RowBox[{"Nobs", "-", "1"}], ")"}]}], "}"}]}], "]"}]}], 
            "]"}], ",", 
           RowBox[{"FourierParameters", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Standardize", "[", 
           RowBox[{"Re", "[", "vec", "]"}], "]"}], "*", "\[Sigma]"}], "+", 
         "\[Mu]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Mimic1", "[", 
      RowBox[{"x_", ",", "z_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "y", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"y", "=", "x"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", " ", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"y", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"Ordering", "[", 
               RowBox[{"z", ",", "i"}], "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "=", 
           RowBox[{"x", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "x", "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "y"}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"TPC", " ", "functions"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"gain", "[", "T_", "]"}], ":=", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"T", "-", "TI"}], ")"}], "^", "2"}], ")"}]}], "/", 
       "\[Beta]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"loss", "[", "T_", "]"}], ":=", 
     RowBox[{
      RowBox[{"ma", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"mb", " ", "T"}], "]"}]}], "+", "mc"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"r", "[", "T_", "]"}], ":=", 
     RowBox[{
      RowBox[{"gain", "[", "T", "]"}], "-", 
