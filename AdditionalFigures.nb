         RowBox[{"{", 
          RowBox[{
          "\"\<Temperature, \!\(\*StyleBox[\"T\",FontSlant->\"Italic\"]\) \
\!\(\*SuperscriptBox[\((\), \(o\)]\)C)\>\"", ",", 
           "\"\<Normalized Fitness \
\!\(\*StyleBox[\"r\",FontSlant->\"Italic\"]\)\>\""}], "}"}]}], ",", 
        RowBox[{"LabelStyle", "->", 
