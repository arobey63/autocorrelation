  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"extTimeMatrixH", "[", 
     RowBox[{"[", "i", "]"}], "]"}], "=", 
