  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"minPopMatrixH", "[", 
     RowBox[{"[", "i", "]"}], "]"}], "=", 
