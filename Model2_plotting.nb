     "\"\<MX\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"minPopP", "=", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{
     "directory", "<>", 
      "\"\<Model3.3_VCOutputs/model3.3_minpop/model3.3.3_minPop_\>\"", "<>", 
      "species", "<>", "\"\<_2014-01-01to2023-12-31_ext1.m\>\""}], ",", 
     "\"\<MX\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"speciesData", "=", 
   RowBox[{"TPCdata", "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", 
      RowBox[{"2", ";;"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
