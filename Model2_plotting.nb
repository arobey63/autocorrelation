Cell[TextData[{
 "This file contains the processing code for Model 2. Before running this \
file, you must have extinction time outputs from running Model 2 for each \
species for both time periods using Model2.nb. Edit import \
(\[OpenCurlyQuote]directory\[CloseCurlyQuote]) and export \
(\[OpenCurlyQuote]saveto\[CloseCurlyQuote]) locations for your own device. ",
 StyleBox["(*",
  FontWeight->"Bold"],
 StyleBox["7 Nov 25 update: ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "fixed bins in outcome bars summary plot",
 StyleBox["*)",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.929465181912716*^9, 3.9294652374581633`*^9}, {
