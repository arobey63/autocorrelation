  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lt", "=", 
   RowBox[{"Drop", "[", 
    RowBox[{"lt", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lt0", "=", 
   RowBox[{"MapIndexed", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#2", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", "#1"}], "}"}], "&"}], ",", 
     "lt"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
