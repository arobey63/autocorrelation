Cell[CellGroupData[{

Cell["Extended Figures", "Section",
 CellChangeTimes->{
  3.929467191161427*^9, {3.929467595157476*^9, 
   3.929467602738999*^9}},ExpressionUUID->"df0f1296-6f50-403b-b31d-\
76650ddcc084"],

Cell["\<\
This code recreates the extended figure plot (containing TPC, temperature \
histograms, and extinction curves) for an individual species. Most design \
elements will update automatically, but \[OpenCurlyQuote]xloc\
\[CloseCurlyQuote], \[OpenCurlyQuote]coordinateloc\[CloseCurlyQuote], and \
\[OpenCurlyQuote]legendloc\[CloseCurlyQuote] require manual aesthetic \
adjustments for some species.\
\>", "Text",
 CellChangeTimes->{{3.929467641182645*^9, 3.9294676791828423`*^9}, {
  3.929468533022092*^9, 
  3.929468604269472*^9}},ExpressionUUID->"69bdc33e-6265-4020-b0f6-\
10c261c2cfe4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"getParameters", "[", "species_String", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "row", "}"}], ",", 
    RowBox[{
     RowBox[{"row", "=", 
      RowBox[{"SelectFirst", "[", 
       RowBox[{"speciesData", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "==", "species"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"row", "===", 
        RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], ",", 
       "\"\<Species not found\>\"", ",", 
       RowBox[{"Rest", "[", "row", "]"}]}], "]"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TPCdata", "=", 
   RowBox[{"Import", "[", 
    RowBox[{"directory", "<>", "\"\<speciesparams.xlsx\>\""}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rD", "[", 
     RowBox[{"T_", ",", "Topt_", ",", "\[Sigma]p_", ",", "CTmax_"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"T", "\[LessEqual]", "Topt"}], ",", 
      RowBox[{"Exp", "[", 
       RowBox[{"-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"T", "-", "Topt"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "\[Sigma]p"}], ")"}]}], ")"}], "^", "2"}]}], "]"}], 
      ",", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"T", "-", "Topt"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"Topt", "-", "CTmax"}], ")"}]}], ")"}], "^", "2"}]}]}], 
     "]"}]}], ";"}], " ", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"species", "=", "\"\<A.pisum\>\""}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"speciesData", "=", 
   RowBox[{"TPCdata", "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", 
      RowBox[{"2", ";;"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"parameters", "=", 
   RowBox[{"getParameters", "[", "species", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CTmax", "=", 
   RowBox[{"parameters", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";", 
  RowBox[{"Topt", "=", 
   RowBox[{"parameters", "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";", 
  RowBox[{"\[Sigma]p", "=", 
   RowBox[{"parameters", "[", 
    RowBox[{"[", "3", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lat", "=", 
   RowBox[{"ToString", "[", 
    RowBox[{"parameters", "[", 
     RowBox[{"[", "4", "]"}], "]"}], "]"}]}], ";", 
  RowBox[{"long", "=", 
   RowBox[{"ToString", "[", 
    RowBox[{"parameters", "[", 
     RowBox[{"[", "5", "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Hgamma", "=", 
   RowBox[{"parameters", "[", 
    RowBox[{"[", "6", "]"}], "]"}]}], ";", 
