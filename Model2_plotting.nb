Cell["This code recreates Fig 5c and d.", "Text",
 CellChangeTimes->{{3.961620028315907*^9, 
  3.9616200421132193`*^9}},ExpressionUUID->"c172154e-767c-4142-a20f-\
68de2fe28baf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"outcomebars", "=", 
   RowBox[{"BarChart", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"13", ",", "8", ",", "5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "6", ",", "1"}], "}"}]}], "}"}], ",", 
     RowBox[{"ChartLayout", "->", "\"\<Stacked\>\""}], ",", 
     RowBox[{"ChartStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Lighter", "[", 
         RowBox[{"RGBColor", "[", "\"\<#9a169c\>\"", "]"}], "]"}], ",", 
        RowBox[{"Lighter", "[", 
         RowBox[{"RGBColor", "[", "\"\<#ed7953\>\"", "]"}], "]"}], ",", 
        RowBox[{"Lighter", "[", 
         RowBox[{"RGBColor", "[", "\"\<#fdca27\>\"", "]"}], "]"}]}], "}"}]}], 
     ",", "\n", 
     RowBox[{"ChartLabels", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<Increased\>\"", ",", "\"\<Decreased\>\""}], "}"}], ",", 
        
        RowBox[{"{", 
         RowBox[{
         "\"\<Proportion Extinct\>\"", ",", "\"\<Extinction Time\>\"", ",", 
          "\"\<Population Size\>\""}], "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
     RowBox[{"ImageSize", "->", "500"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Extinction Risk Outcome\>\"", ",", "\"\<Number of Species\>\""}], 
       "}"}]}], ",", 
     RowBox[{"FrameStyle", "->", "16"}], ",", 
     RowBox[{"\"\<FixedBarSpacing\>\"", "->", "True"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"regionbars", "=", 
   RowBox[{"BarChart", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"17", ",", "8"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"6", ",", "0", ",", "2"}], "}"}]}], "}"}], ",", 
     RowBox[{"ChartLayout", "->", "\"\<Stacked\>\""}], ",", 
     RowBox[{"ChartStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"RGBColor", "[", "\"\<#c0665e\>\"", "]"}], ",", 
        RowBox[{"RGBColor", "[", "\"\<#aeceeb\>\"", "]"}], ",", 
        RowBox[{"RGBColor", "[", "\"\<#dacfbe\>\"", "]"}]}], "}"}]}], ",", 
     RowBox[{"ChartLabels", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "\"\<Northern\\n Hemisphere\>\"", ",", "\"\<Tropics\>\"", ",", 
          "\"\<Southern\\n Hemisphere\>\""}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
         "\"\<Higher Risk\>\"", ",", "\"\<Lower Risk\>\"", ",", 
          "\"\<No Change\>\""}], "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
     RowBox[{"ImageSize", "->", "500"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"None", ",", "\"\<Number of Species\>\""}], "}"}]}], ",", 
     RowBox[{"FrameStyle", "->", "16"}], ",", 
     RowBox[{"\"\<FixedBarSpacing\>\"", "->", "True"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"saveto", "<>", "\"\<barchart_outcome.pdf\>\""}], ",", 
    "outcomebars", ",", 
