Cell[CellGroupData[{

Cell["Figure 4: Time to Extinction", "Section",
 CellChangeTimes->{{3.917534811277513*^9, 
  3.917534820300209*^9}},ExpressionUUID->"e3ee7bc0-489f-4589-83d8-\
4a64cb5c4f82"],

Cell["\<\
Calculate the average time to extinction across simulations at each point in \
the parameter space, then plot the corresponding heat maps of extinction time \
for each parameter combination. \
\>", "Text",
 CellChangeTimes->{{3.917534842366581*^9, 
  3.917534860928388*^9}},ExpressionUUID->"8a3ed066-f2a3-48c0-917f-\
16991b42215b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"extTimeMeans", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"21", ",", "7", ",", "7"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"extTimeMeans", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"extTime", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "21"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "1", ",", "7"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "1", ",", "7"}], "}"}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"extTimeStds", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"21", ",", "7", ",", "7"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"extTimeStds", "[", 
     RowBox[{"[", 
      RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], "=", 
    RowBox[{"StandardDeviation", "[", 
     RowBox[{"extTime", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", "21"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"j", ",", "1", ",", "7"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", "1", ",", "7"}], "}"}]}], "]"}]}], "Input",
 CellLabel->
  "In[1301]:=",ExpressionUUID->"1084248e-aca8-4fb7-b226-79fdce28407a"],

Cell["\<\
Subplot a) autocorrelation against mean temperature at each value of the \
standard deviation.\
\>", "Text",
 CellChangeTimes->{{3.917534931218071*^9, 
  3.917534948411605*^9}},ExpressionUUID->"a9866b23-d74a-4832-90d5-\
ba5ca4b9d18f"],

