Cell["Figure 3: Proportion Extinct", "Section",
 CellChangeTimes->{{3.917534237153441*^9, 
  3.91753424617914*^9}},ExpressionUUID->"2da1a44c-6fc7-4ca5-80e5-\
9f297f3fd1ef"],

Cell["\<\
Calculate the proportion of simulations to go extinct at each point in the \
parameter space, then plot the corresponding heat maps of extinction risk for \
each parameter combination. \
\>", "Text",
 CellChangeTimes->{{3.917534299146522*^9, 
  3.9175343516776943`*^9}},ExpressionUUID->"89d8dc50-805a-405b-9389-\
8fb43aa2a08a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"propExt", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"21", ",", "7", ",", "7"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"propExt", "[", 
     RowBox[{"[", 
      RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], "=", 
    RowBox[{
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{"extTime", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], ",", "2000"}], 
      "]"}], "/", "1000"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", "21"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"j", ",", "1", ",", "7"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", "1", ",", "7"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9175344139183397`*^9, 3.917534414639604*^9}, 
   3.917534457041584*^9, {3.9175345006928368`*^9, 3.91753450280926*^9}},
 CellLabel->
  "In[1267]:=",ExpressionUUID->"825cc24b-db64-41e2-ae9e-266b561215ca"],

Cell["\<\
