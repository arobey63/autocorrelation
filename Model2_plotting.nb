Cell["\<\
This code recreates plots of mean time to extinction for individual species \
that went extinct under 100% of scenarios.\
\>", "Text",
 CellChangeTimes->{{3.929468917174181*^9, 
  3.929468942589251*^9}},ExpressionUUID->"3a318ba3-2ece-49d7-858c-\
d9f1f462ea65"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"getParameters", "[", "species_String", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "row", "}"}], ",", 
    RowBox[{
     RowBox[{"row", "=", 
      RowBox[{"SelectFirst", "[", 
       RowBox[{"speciesData", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "==", "species"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"row", "===", 
        RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], ",", 
       "\"\<Species not found\>\"", ",", 
       RowBox[{"Rest", "[", "row", "]"}]}], "]"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TPCdata", "=", 
    RowBox[{"Import", "[", 
     RowBox[{"directory", "<>", "\"\<speciesparams.xlsx\>\""}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"species", "=", "\"\<S.miscanthi\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"extTimeH", "=", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{
