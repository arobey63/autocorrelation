Cell["\<\
This code allows you to extract the spectral exponent and, if desired, plot \
the spectral density of any of the temperature time series.\
\>", "Text",
 CellChangeTimes->{{3.9294694476354847`*^9, 
  3.929469481434586*^9}},ExpressionUUID->"b7d71829-5f59-4ac6-9678-\
f47e8f3aed4b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"getParameters", "[", "species_String", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "row", "}"}], ",", 
     RowBox[{
      RowBox[{"row", "=", 
       RowBox[{"SelectFirst", "[", 
        RowBox[{"speciesData", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "==", "species"}], "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"row", "===", 
         RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], ",", 
        "\"\<Species not found\>\"", ",", 
        RowBox[{"Rest", "[", "row", "]"}]}], "]"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TPCdata", "=", 
   RowBox[{"Import", "[", 
    RowBox[{"directory", "<>", "\"\<speciesparams.xlsx\>\""}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"speciesData", "=", 
   RowBox[{"TPCdata", "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", 
      RowBox[{"2", ";;"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"species", "=", "\"\<C.shadabi\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"historic", "=", "\"\<1994-01-01to2003-12-31\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"present", "=", "\"\<2014-01-01to2023-12-31\>\""}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"parameters", "=", 
   RowBox[{"getParameters", "[", "species", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lat", "=", 
   RowBox[{"ToString", "[", 
    RowBox[{"parameters", "[", 
     RowBox[{"[", "4", "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"long", "=", 
    RowBox[{"ToString", "[", 
     RowBox[{"parameters", "[", 
      RowBox[{"[", "5", "]"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"data", "=", 
    RowBox[{"Import", "[", 
     RowBox[{
      RowBox[{
      "directory", "<>", "\"\<VisualCrossingData/\>\"", "<>", "species", 
       "<>", "\"\<_\>\"", "<>", "lat", "<>", "\"\<,\>\"", "<>", "long", "<>", 
       "\"\<_\>\"", "<>", "historic", "<>", "\"\<.csv\>\""}], ",", 
      "\"\<CSV\>\""}], "]"}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{"temps", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"data", "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"2", ";;"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lt", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"Fourier", "[", 
       RowBox[{"{", "temps", "}"}], "]"}], "]"}], "^", "2"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lt", "=", 
   RowBox[{"Drop", "[", 
    RowBox[{"lt", ",", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Length", "[", "lt", "]"}]}], "/", "2"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lt", "=", 
   RowBox[{"Drop", "[", 
    RowBox[{"lt", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lt0", "=", 
   RowBox[{"MapIndexed", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#2", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", "#1"}], "}"}], "&"}], ",", 
     "lt"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fit0", "=", 
   RowBox[{"Fit", "[", 
    RowBox[{
     RowBox[{"Log", "[", "lt0", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "x"}], "}"}], ",", "x"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"data", "=", 
    RowBox[{"Import", "[", 
     RowBox[{
      RowBox[{
      "directory", "<>", "\"\<VisualCrossingData/\>\"", "<>", "species", 
       "<>", "\"\<_\>\"", "<>", "lat", "<>", "\"\<,\>\"", "<>", "long", "<>", 
       "\"\<_\>\"", "<>", "present", "<>", "\"\<.csv\>\""}], ",", 
      "\"\<CSV\>\""}], "]"}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{"temps", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"data", "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"2", ";;"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"lt", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"Fourier", "[", 
       RowBox[{"{", "temps", "}"}], "]"}], "]"}], "^", "2"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lt", "=", 
   RowBox[{"Drop", "[", 
    RowBox[{"lt", ",", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Length", "[", "lt", "]"}]}], "/", "2"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lt", "=", 
   RowBox[{"Drop", "[", 
    RowBox[{"lt", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lt0", "=", 
   RowBox[{"MapIndexed", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#2", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", "#1"}], "}"}], "&"}], ",", 
     "lt"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fit0", "=", 
   RowBox[{"Fit", "[", 
    RowBox[{
     RowBox[{"Log", "[", "lt0", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "x"}], "}"}], ",", "x"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLinePlot", "[", 
    RowBox[{"lt", ",", 
     RowBox[{"ScalingFunctions", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Log\>\"", ",", "\"\<Log\>\""}], "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<frequency\>\"", ",", "\"\<spectral density\>\""}], 
       "}"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"2.6340898511613706", "-", 
      RowBox[{"0.3970554074582351", "x"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "tmax"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.929469513378071*^9, 3.929469613610927*^9}, {
  3.9616198398497047`*^9, 3.96161985788105*^9}},
 CellLabel->
  "In[136]:=",ExpressionUUID->"2da1c45f-a927-4c58-ae49-ca903e77514d"],

