Cell[BoxData[{
 RowBox[{
  RowBox[{"getParameters", "[", "species_String", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "row", "}"}], ",", 
    RowBox[{
     RowBox[{"row", "=", 
      RowBox[{"SelectFirst", "[", 
       RowBox[{"speciesData", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "==", "species"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"row", "===", 
        RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], ",", 
       "\"\<Species not found\>\"", ",", 
       RowBox[{"Rest", "[", "row", "]"}]}], "]"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TPCdata", "=", 
    RowBox[{"Import", "[", 
     RowBox[{"directory", "<>", "\"\<speciesparams.xlsx\>\""}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"species", "=", "\"\<B.argentifolia\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"minPopH", "=", 
