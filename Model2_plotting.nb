    RowBox[{"rD", "[", 
     RowBox[{"T_", ",", "Topt_", ",", "\[Sigma]p_", ",", "CTmax_"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"T", "\[LessEqual]", "Topt"}], ",", 
      RowBox[{"Exp", "[", 
       RowBox[{"-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"T", "-", "Topt"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "\[Sigma]p"}], ")"}]}], ")"}], "^", "2"}]}], "]"}], 
      ",", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"T", "-", "Topt"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"Topt", "-", "CTmax"}], ")"}]}], ")"}], "^", "2"}]}]}], 
     "]"}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TcTPC", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"rD", "[", 
      RowBox[{"T", ",", "Topt", ",", "\[Sigma]p", ",", "CTmax"}], "]"}], ",", 
     
     RowBox[{"{", 
      RowBox[{"T", ",", "3", ",", "35"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"3", ",", "34"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", ".2"}], ",", "1.1"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"AxesOrigin", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "10"}], ",", "0"}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"Darker", "[", "Purple", "]"}]}], ",", 
     RowBox[{"Filling", "->", "Axis"}], ",", 
     RowBox[{"Frame", "->", 
      RowBox[{"{", 
       RowBox[{"True", ",", "False", ",", "False", ",", "True"}], "}"}]}], 
     ",", 
     RowBox[{"FrameStyle", "->", "18"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Temperature, \!\(\*StyleBox[\"T\",FontSlant->\"Italic\"]\) \
\!\(\*SuperscriptBox[\((\), \(o\)]\)C)\>\"", ",", "None", ",", "None", ",", 
        "\"\<Normalized Fitness \!\(\*StyleBox[\"r\",FontSlant->\"Italic\"]\)\
\>\""}], "}"}]}], ",", 
     RowBox[{"LabelStyle", "->", 
      RowBox[{"Directive", "[", "Black", "]"}]}], ",", 
     RowBox[{"FrameTicks", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"10", ",", "20", ",", "30"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0.5", ",", "1"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"Epilog", "->", 
      RowBox[{"{", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Text", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"ToString", "[", "name", "]"}], ",", 
             RowBox[{"FontWeight", "->", "Bold"}], ",", 
             RowBox[{"FontSlant", "->", "Italic"}]}], "]"}], ",", 
           RowBox[{"{", 
