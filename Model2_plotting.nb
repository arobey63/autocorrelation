Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"outcomebars", "=", 
   RowBox[{"BarChart", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"13", ",", "8", ",", "5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "1", ",", "6"}], "}"}]}], "}"}], ",", 
     RowBox[{"ChartLayout", "->", "\"\<Stacked\>\""}], ",", 
     RowBox[{"ChartStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Lighter", "[", 
         RowBox[{"RGBColor", "[", "\"\<#9a169c\>\"", "]"}], "]"}], ",", 
        RowBox[{"Lighter", "[", 
         RowBox[{"RGBColor", "[", "\"\<#ed7953\>\"", "]"}], "]"}], ",", 
        RowBox[{"Lighter", "[", 
         RowBox[{"RGBColor", "[", "\"\<#fdca27\>\"", "]"}], "]"}]}], "}"}]}], 
     ",", "\n", 
     RowBox[{"ChartLabels", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<Increased\>\"", ",", "\"\<Decreased\>\""}], "}"}], ",", 
        
        RowBox[{"{", 
         RowBox[{
         "\"\<Proportion Extinct\>\"", ",", "\"\<Extinction Time\>\"", ",", 
          "\"\<Population Size\>\""}], "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
     RowBox[{"ImageSize", "->", "500"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Extinction Risk Outcome\>\"", ",", "\"\<Number of Species\>\""}], 
       "}"}]}], ",", 
     RowBox[{"FrameStyle", "->", "16"}], ",", 
     RowBox[{"\"\<FixedBarSpacing\>\"", "->", "True"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"regionbars", "=", 
   RowBox[{"BarChart", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"17", ",", "8"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"6", ",", "0", ",", "2"}], "}"}]}], "}"}], ",", 
     RowBox[{"ChartLayout", "->", "\"\<Stacked\>\""}], ",", 
     RowBox[{"ChartStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"RGBColor", "[", "\"\<#c0665e\>\"", "]"}], ",", 
        RowBox[{"RGBColor", "[", "\"\<#aeceeb\>\"", "]"}], ",", 
        RowBox[{"RGBColor", "[", "\"\<#dacfbe\>\"", "]"}]}], "}"}]}], ",", 
     RowBox[{"ChartLabels", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "\"\<Northern\\n Hemisphere\>\"", ",", "\"\<Tropics\>\"", ",", 
          "\"\<Southern\\n Hemisphere\>\""}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
         "\"\<Higher Risk\>\"", ",", "\"\<Lower Risk\>\"", ",", 
          "\"\<No Change\>\""}], "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
     RowBox[{"ImageSize", "->", "500"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"None", ",", "\"\<Number of Species\>\""}], "}"}]}], ",", 
     RowBox[{"FrameStyle", "->", "16"}], ",", 
     RowBox[{"\"\<FixedBarSpacing\>\"", "->", "True"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"saveto", "<>", "\"\<barchart_outcome.pdf\>\""}], ",", 
    "outcomebars", ",", 
    RowBox[{"ImageResolution", "\[Rule]", "1000"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"saveto", "<>", "\"\<barchart_region.pdf\>\""}], ",", 
    "regionbars", ",", 
    RowBox[{"ImageResolution", "\[Rule]", "1000"}]}], "]"}], ";"}]}], "Input",\

