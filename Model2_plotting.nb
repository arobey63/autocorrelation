Cell["\<\
This code recreates plots of average minimum abundance for individual species \
that went extinct under 0% of scenarios.\
\>", "Text",
 CellChangeTimes->{{3.929469092303362*^9, 
  3.929469108482214*^9}},ExpressionUUID->"ab098039-5c32-42d0-81d6-\
7ce335e85a57"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"getParameters", "[", "species_String", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "row", "}"}], ",", 
    RowBox[{
     RowBox[{"row", "=", 
      RowBox[{"SelectFirst", "[", 
       RowBox[{"speciesData", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "==", "species"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"row", "===", 
        RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], ",", 
       "\"\<Species not found\>\"", ",", 
       RowBox[{"Rest", "[", "row", "]"}]}], "]"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TPCdata", "=", 
    RowBox[{"Import", "[", 
     RowBox[{"directory", "<>", "\"\<speciesparams.xlsx\>\""}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"species", "=", "\"\<B.argentifolia\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"minPopH", "=", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{
     "directory", "<>", 
      "\"\<Model3.3_VCoutputs/model3.3_minpop/model3.3.3_minPop_\>\"", "<>", 
      "species", "<>", "\"\<_1994-01-01to2003-12-31_ext1.m\>\""}], ",", 
     "\"\<MX\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"minPopP", "=", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{
     "directory", "<>", 
      "\"\<Model3.3_VCOutputs/model3.3_minpop/model3.3.3_minPop_\>\"", "<>", 
      "species", "<>", "\"\<_2014-01-01to2023-12-31_ext1.m\>\""}], ",", 
     "\"\<MX\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"speciesData", "=", 
   RowBox[{"TPCdata", "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", 
      RowBox[{"2", ";;"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"parameters", "=", 
   RowBox[{"getParameters", "[", "species", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Hgamma", "=", 
   RowBox[{"parameters", "[", 
    RowBox[{"[", "6", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Pgamma", "=", 
   RowBox[{"parameters", "[", 
    RowBox[{"[", "7", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"name", "=", 
    RowBox[{"parameters", "[", 
     RowBox[{"[", "14", "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Gamma]vals", "=", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", "2", ",", ".1"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"minPopMatrixH", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", 
     RowBox[{"Length", "[", "\[Gamma]vals", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"minPopMatrixH", "[", 
     RowBox[{"[", "i", "]"}], "]"}], "=", 
    RowBox[{"Mean", "[", 
     RowBox[{"minPopH", "[", 
      RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", 
     RowBox[{"Length", "[", "\[Gamma]vals", "]"}]}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"minPopsH", "=", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"\[Gamma]vals", ",", "minPopMatrixH"}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"minPopMatrixP", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", 
     RowBox[{"Length", "[", "\[Gamma]vals", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"minPopMatrixP", "[", 
     RowBox[{"[", "i", "]"}], "]"}], "=", 
    RowBox[{"Mean", "[", 
     RowBox[{"minPopP", "[", 
      RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
