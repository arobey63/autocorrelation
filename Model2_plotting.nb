Cell[CellGroupData[{

Cell["Dot plot summary of results", "Subsection",
 CellChangeTimes->{{3.9294669819007807`*^9, 3.9294669913614607`*^9}, {
   3.9616194963023157`*^9, 3.961619500035865*^9}, 
   3.9616196517781982`*^9},ExpressionUUID->"5ad680bc-4b14-47af-abd6-\
e5cad4af2cc5"],

Cell["These figures require .csvs of point locations.", "Text",
 CellChangeTimes->{{3.929467005100144*^9, 
  3.929467016760941*^9}},ExpressionUUID->"6dd56ca4-358c-4ce0-b28d-\
e8ca7bb66981"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"usefuldata", "=", 
   RowBox[{"Import", "[", 
    RowBox[{"directory", "<>", "\"\<usefulpoints.csv\>\""}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"speciesData1", "=", 
   RowBox[{"Rest", "[", "usefuldata", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"points1", "=", 
    RowBox[{"speciesData1", "/.", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "species_", ",", "hGamma_", ",", "hPExt_", ",", "pGamma_", ",", 
        "pPExt_"}], "}"}], ":>", 
      RowBox[{"{", 
       RowBox[{"species", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"hGamma", ",", "hPExt"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"pGamma", ",", "pPExt"}], "}"}]}], "}"}]}], "}"}]}]}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uselessdata", "=", 
   RowBox[{"Import", "[", 
    RowBox[{"directory", "<>", "\"\<uselesspoints.csv\>\""}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"speciesData2", "=", 
   RowBox[{"Rest", "[", "uselessdata", "]"}]}], ";"}], "\[IndentingNewLine]", 

 RowBox[{
  RowBox[{
   RowBox[{"points2", "=", 
    RowBox[{"speciesData2", "/.", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "species_", ",", "hGamma_", ",", "hPExt_", ",", "pGamma_", ",", 
        "pPExt_"}], "}"}], ":>", 
      RowBox[{"{", 
       RowBox[{"species", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"hGamma", ",", "hPExt"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"pGamma", ",", "pPExt"}], "}"}]}], "}"}]}], "}"}]}]}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pext", "=", 
    RowBox[{"Graphics", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
