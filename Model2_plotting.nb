Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"cmplx", "[", 
     RowBox[{"mod_", ",", "arg_"}], "]"}], ":=", 
    RowBox[{"ExpToTrig", "[", 
     RowBox[{"mod", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "arg"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SpecSynFourier", "[", 
     RowBox[{"\[Gamma]_", ",", "Nobs_", ",", 
      RowBox[{"\[Mu]_", ":", "0"}], ",", 
      RowBox[{"\[Sigma]_", ":", "1"}], ",", 
      RowBox[{"seed_", ":", "0"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"phase", ",", "f", ",", "fseries", ",", "vec"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"seed", "\[Equal]", "0"}], ",", 
         RowBox[{"SeedRandom", "[", "]"}], ",", 
         RowBox[{"SeedRandom", "[", "seed", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"phase", "=", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"2", "Pi"}]}], "}"}], ",", "Nobs"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"f", "=", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"1", "/", "Nobs"}], ",", "0.5", ",", 
          RowBox[{"1", "/", "Nobs"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"fseries", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", "+", 
            RowBox[{"0", "I"}]}], "}"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"cmplx", "[", 
             RowBox[{
              RowBox[{"1", "/", 
               RowBox[{
                RowBox[{"f", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", 
                RowBox[{"(", 
                 RowBox[{"\[Gamma]", "/", "2"}], " ", ")"}]}]}], ",", 
              RowBox[{"phase", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"Length", "[", "f", "]"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"cmplx", "[", 
             RowBox[{
              RowBox[{"1", "/", 
               RowBox[{
                RowBox[{"f", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", 
                RowBox[{"(", 
                 RowBox[{"\[Gamma]", "/", "2"}], " ", ")"}]}]}], ",", 
              RowBox[{
               RowBox[{"-", "1"}], "*", 
               RowBox[{"phase", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{
               RowBox[{"Length", "[", "f", "]"}], "-", "1"}], ",", "1", ",", 
              RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vec", "=", 
        RowBox[{"InverseFourier", "[", 
         RowBox[{"fseries", ",", 
          RowBox[{"FourierParameters", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Standardize", "[", 
          RowBox[{"Re", "[", 
           RowBox[{"vec", "[", 
            RowBox[{"[", 
             RowBox[{"1", ";;", "Nobs"}], "]"}], "]"}], "]"}], "]"}], "*", 
         "\[Sigma]"}], "+", "\[Mu]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"changeautocorr", "[", 
    RowBox[{"X_", ",", "\[Gamma]_", ",", "samplesperyear_", ",", 
     RowBox[{"seed_", ":", "0"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
      "var", ",", "Y", ",", "fftdata", ",", "mean", ",", "mmeandevs", ",", 
       "adjvar", ",", "powersp", ",", "int", ",", "lm", ",", "a", ",", "b", 
       ",", 
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "X", "]"}]}], ",", "phase", ",", "f", ",", 
       "vec", ",", "Z"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"mean", "=", 
       RowBox[{"Mean", "[", "X", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"var", "=", 
       RowBox[{"Variance", "[", 
        RowBox[{"X", "-", "mean"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"mmeandevs", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Mean", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"X", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "j", ",", "n", ",", "samplesperyear"}], 
             "}"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "samplesperyear"}], "}"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Y", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"X", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "-", 
          RowBox[{"mmeandevs", "[", 
           RowBox[{"[", 
            RowBox[{"Mod", "[", 
             RowBox[{"i", ",", "samplesperyear", ",", "1"}], "]"}], "]"}], 
           "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"adjvar", "=", 
       RowBox[{"Variance", "[", "Y", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fftdata", "=", 
       RowBox[{"Fourier", "[", 
        RowBox[{"Y", ",", 
         RowBox[{"FourierParameters", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"powersp", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"i", "/", "n"}], ",", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"fftdata", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}], "]"}], "^", "2"}]}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{
            RowBox[{"n", "/", "2"}], "-", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"lm", "=", 
       RowBox[{"LinearModelFit", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Log", "[", "#1", "]"}], ",", 
             RowBox[{"Log", "[", "#2", "]"}]}], "}"}], "&"}], "@@@", 
          "powersp"}], ",", "x", ",", "x"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"seed", "\[Equal]", "0"}], ",", 
        RowBox[{"SeedRandom", "[", "]"}], ",", 
        RowBox[{"SeedRandom", "[", "seed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"phase", "=", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"2", "Pi"}]}], "}"}], ",", "n"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"f", "=", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"1", "/", "n"}], ",", "1", ",", 
         RowBox[{"1", "/", "n"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vec", "=", 
       RowBox[{"InverseFourier", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", "+", 
             RowBox[{"0", "I"}]}], "}"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"cmplx", "[", 
              RowBox[{
               RowBox[{"1", "/", 
                RowBox[{
                 RowBox[{"f", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "^", 
                 RowBox[{"(", 
                  RowBox[{"\[Gamma]", "/", "2"}], " ", ")"}]}]}], ",", 
               RowBox[{"phase", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"Length", "[", "f", "]"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"cmplx", "[", 
              RowBox[{
               RowBox[{"1", "/", 
                RowBox[{
                 RowBox[{"f", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "^", 
                 RowBox[{"(", 
                  RowBox[{"\[Gamma]", "/", "2"}], " ", ")"}]}]}], ",", 
               RowBox[{
                RowBox[{"-", "1"}], "*", 
                RowBox[{"phase", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{
                RowBox[{"Length", "[", "f", "]"}], "-", "1"}], ",", "1", ",", 
               
               RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], "]"}], ",", 
         RowBox[{"FourierParameters", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Z", "=", 
       RowBox[{
        RowBox[{"Standardize", "[", 
         RowBox[{"Re", "[", "vec", "]"}], "]"}], "*", 
        RowBox[{"Sqrt", "[", "adjvar", "]"}]}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"lm", ",", "var", ",", "adjvar"}], "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Z", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "+", 
           RowBox[{"mmeandevs", "[", 
            RowBox[{"[", 
             RowBox[{"Mod", "[", 
              RowBox[{"i", ",", "samplesperyear", ",", "1"}], "]"}], "]"}], 
            "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Mimic1", "[", 
     RowBox[{"x_", ",", "z_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "y", "}"}], ",", "\[IndentingNewLine]", 
