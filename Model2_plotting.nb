   RowBox[{"minPopsH", "=", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"\[Gamma]vals", ",", "minPopMatrixH"}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
