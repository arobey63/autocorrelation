Cell[CellGroupData[{

Cell["Figure 3b: Time to Extinction", "Section",
 CellChangeTimes->{{3.917534811277513*^9, 3.917534820300209*^9}, {
  3.961615097046515*^9, 
  3.961615097476694*^9}},ExpressionUUID->"e3ee7bc0-489f-4589-83d8-\
4a64cb5c4f82"],

Cell["\<\
Calculate the average time to extinction across simulations at each point in \
the parameter space, then plot the corresponding heat maps of extinction time \
for each parameter combination. Results not shown in main paper are included \
in Appendix S5.\
\>", "Text",
 CellChangeTimes->{{3.917534842366581*^9, 3.917534860928388*^9}, {
  3.961615101224889*^9, 
  3.961615129839374*^9}},ExpressionUUID->"8a3ed066-f2a3-48c0-917f-\
16991b42215b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"extTimeMeans", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"21", ",", "7", ",", "7"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"extTimeMeans", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"extTime", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "21"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "1", ",", "7"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "1", ",", "7"}], "}"}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"extTimeStds", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"21", ",", "7", ",", "7"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"extTimeStds", "[", 
     RowBox[{"[", 
      RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], "=", 
    RowBox[{"StandardDeviation", "[", 
     RowBox[{"extTime", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", "21"}], "}"}], ",", 
   RowBox[{"{", 
